{
  "name": "film-diary-monorepo",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev:web": "yarn workspace @film-diary/web dev",
    "build:web": "yarn workspace @film-diary/web build",
    "lint:web": "yarn workspace @film-diary/web lint",
    "dev:api": "cd apps/api && yarn dev",
    "build:api": "cd apps/api && yarn build"
  }
}
