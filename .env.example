# ── Docker Compose environment ────────────────────────────────────────────────
# Copy to .env and fill in strong random values:
#   cp .env.example .env
# Generate secrets e.g. with: openssl rand -hex 16

# PostgreSQL (never exposed to the host network)
POSTGRES_DB=film_diary
POSTGRES_USER=film_diary
POSTGRES_PASSWORD=

# Read-only DB role used by the public Node API (SELECT only)
API_READER_PASSWORD=
