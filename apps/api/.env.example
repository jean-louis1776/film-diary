# ── Film Diary public API (Fastify) ──────────────────────────────────────────
# Copy to .env. DATABASE_URL uses the read-only role api_reader (SELECT only);
# password comes from API_READER_PASSWORD in the root .env.
DATABASE_URL=postgres://api_reader:CHANGE_ME@db:5432/film_diary
PORT=3001
HOST=0.0.0.0
# "*" allows any origin (fine for a public read-only API); or a comma-separated allowlist
CORS_ORIGINS=*
# Public base URL images are served from (the CDN in front of the bucket)
CDN_URL=https://ik.imagekit.io/ilalex
