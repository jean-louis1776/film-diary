# ── Film Diary admin (Laravel + Filament) ────────────────────────────────────
# Copy to .env and fill in. Generate APP_KEY with:
#   docker compose exec admin php artisan key:generate

APP_NAME="Film Diary Admin"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

# PostgreSQL — hostname "db" is the compose service, never exposed to the host
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=film_diary
DB_USERNAME=film_diary
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true when serving over HTTPS (production)
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="admin@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── Object storage: Backblaze B2 (S3 API) ────────────────────────────────────
# Create an application key scoped to ONE bucket with read/write access:
#   B2 Console → App Keys → Add a New Application Key
#   keyID → AWS_ACCESS_KEY_ID, applicationKey → AWS_SECRET_ACCESS_KEY
# The region is part of the bucket endpoint, e.g. eu-central-003.
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-central-003
AWS_BUCKET=
AWS_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
AWS_USE_PATH_STYLE_ENDPOINT=false

# Public base URL images are served from (the CDN in front of the bucket)
CDN_URL=https://ik.imagekit.io/ilalex

VITE_APP_NAME="${APP_NAME}"

# Password hashing (argon2id is available in the FrankenPHP image)
HASH_DRIVER=argon2id
